# Server-side only. Enable Places API (New) for this key and never expose it to the browser.
GOOGLE_PLACES_API_KEY=

# Auth0 Single Page Application + API. These values are identifiers, not client secrets.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

# Server-side only. Tripadvisor Terra API key (terra.tripadvisor.com, self-serve; the old
# Content API was switched off on 31 August 2026). Optional: without it the place sheet
# shows Google reviews only. Tripadvisor content is shown to users, never sent to the model.
TRIPADVISOR_API_KEY=

# Server-side only. Powers the Cicero conversational agent (Claude).
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: claude-opus-5 and effort "low" (chat latency); set CICERO_EFFORT=medium for more deliberate planning.
ANTHROPIC_MODEL=
CICERO_EFFORT=

# Spend guards for the paid upstreams (Claude + Google Places), counted in D1.
# Production defaults: 20 chat requests per client every 10 minutes, 300 per day
# in total. CICERO_RATE_LIMIT=0 disables both, which the GUI test suite needs.
CICERO_RATE_LIMIT=
CICERO_DAILY_CHAT_BUDGET=
# Daily caps for the paid Places lookups (production defaults in brackets):
# landing points of interest [600], pins that follow the map [400], reviews in the sheet [300].
CICERO_DAILY_DISCOVER_BUDGET=
CICERO_DAILY_EXPLORE_BUDGET=
CICERO_DAILY_REVIEWS_BUDGET=

# Set to 1 only where a trusted proxy (OpenAI Sites) sets oai-authenticated-user-id.
# Anywhere else that header is forgeable, so profiles stay unreachable without Auth0.
CICERO_TRUST_SITES_HEADER=1
