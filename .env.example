# Server-side only. Enable Places API (New) for this key and never expose it to the browser.
GOOGLE_PLACES_API_KEY=

# Auth0 Single Page Application + API. These values are identifiers, not client secrets.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

# Server-side only. Tripadvisor Content API partner key.
TRIPADVISOR_API_KEY=

# Server-side only. Powers the Cicero conversational agent (Claude).
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: claude-opus-5 and effort "low" (chat latency); set CICERO_EFFORT=medium for more deliberate planning.
ANTHROPIC_MODEL=
CICERO_EFFORT=
